<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <title>Fioxify – Login</title>
  <link rel="stylesheet" href="css/style.css" />
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.39.7/dist/umd/supabase.js"></script>
  <script defer src="app.js"></script>
</head>
<body class="auth-body">
  <div class="auth-container">
    <h1 class="logo">Fioxify</h1>

    <div class="auth-tabs">
      <button id="tab-login" class="auth-tab active">Login</button>
      <button id="tab-register" class="auth-tab">Registrati</button>
    </div>

    <div id="login-form" class="auth-form active">
      <input type="email" id="login-email" placeholder="Email" />
      <input type="password" id="login-password" placeholder="Password" />
      <button id="login-btn">Entra</button>
      <p class="auth-error" id="login-error"></p>
    </div>

    <div id="register-form" class="auth-form">
      <input type="email" id="register-email" placeholder="Email" />
      <input type="password" id="register-password" placeholder="Password" />
      <button id="register-btn">Crea account</button>
      <p class="auth-error" id="register-error"></p>
    </div>
  </div>
</body>
</html>
